PORT=8080
ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://dapur:dapur_dev@localhost:5432/dapur?sslmode=disable

# LLM Provider — OpenRouter (recommended)
# OpenRouter is an OpenAI-compatible API gateway with 500+ models.
# Sign up at https://openrouter.ai (free $5 credit on signup).
# Any OpenAI-compatible provider works: https://openrouter.ai/api/v1,
# https://opencode.ai/zen/go/v1 (when deployed), https://api.openai.com/v1,
# https://api.together.xyz/v1, https://api.groq.com/openai/v1,
# http://localhost:11434/v1 (Ollama local), etc.
OPENAI_API_KEY=sk-or-...
OPENAI_MODEL=anthropic/claude-3.5-sonnet
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_TIMEOUT=60s

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3004
