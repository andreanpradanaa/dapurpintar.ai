# DapurPintar AI — Backend environment
# Copy to .env and fill in values.
# Required variables must be set for the API server to start.

# === Required ===
APP_NAME=dapurpintar
APP_ENV=development
APP_PORT=8080

# PostgreSQL system-of-record (M4-DEC-003)
DATABASE_URL=postgres://dapurpintar:dapurpintar@localhost:5432/dapurpintar?sslmode=disable

# JWT signing secret (min 32 chars; generate with: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-random-32-char-secret

# === Optional ===

# Redis (non-authoritative cache)
REDIS_URL=

# OpenTelemetry
OTLP_ENDPOINT=http://localhost:4318
OTLP_DISABLE=true

# Session
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SESSION_COOKIE_NAME=dp_session

# AI Gateway (leave empty to disable AI features)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30s
AI_MAX_RETRIES=1

# Test database (for integration tests)
TEST_DATABASE_URL=postgres://dapurpintar:dapurpintar@localhost:5432/dapurpintar?sslmode=disable
