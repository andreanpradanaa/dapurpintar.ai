flowchart LR
    subgraph Identity[Identity and Access]
        Account[Aggregate Root: Account]
    end

    subgraph User[User Context and Preferences]
        Profile[Aggregate Root: User Profile]
        Preference[Entity: Preference Set]
        Profile --- Preference
    end

    subgraph Pantry[Pantry Management]
        PantryRoot[Aggregate Root: Pantry]
        PantryItem[Entity: Pantry Item]
        PantryRoot --- PantryItem
    end

    subgraph Recipe[Recipe Experience]
        RecipeRoot[Aggregate Root: Recipe]
        Favorite[Entity: Recipe Favorite]
        RecipeRoot --- Favorite
    end

    subgraph Core[AI Kitchen Intelligence]
        Recommendation[Aggregate Root: Kitchen Recommendation]
        Option[Entity: Recommendation Option]
        Conversation[Entity: Recommendation Conversation]
        Recommendation --- Option
        Recommendation --- Conversation
    end

    subgraph Planning[Meal Planning]
        MealPlan[Aggregate Root: Meal Plan]
        PlannedMeal[Entity: Planned Meal]
        MealPlan --- PlannedMeal
    end

    subgraph Shopping[Shopping Planning]
        List[Aggregate Root: Shopping List]
        Item[Entity: Shopping Item]
        List --- Item
    end

    Account -->|trusted identity| Profile
    Profile -->|personal context| Recommendation
    PantryRoot -->|available ingredients| Recommendation
    RecipeRoot -->|cooking options| Recommendation
    Recommendation -->|accepted cooking guidance| MealPlan
    Recommendation -->|purchase intent| List
    MealPlan -->|planned ingredient needs| List

    PantryRoot -.->|expiry attention| Recommendation
    Recommendation -.->|decision feedback| Profile
