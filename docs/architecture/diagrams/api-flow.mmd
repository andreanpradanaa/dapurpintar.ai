flowchart TD
    User[User]
    REST[REST API<br/>/api/v1 public contract]

    subgraph Backend[Backend Modular Monolith]
        Application[Application Layer<br/>Use-case orchestration]
        Domain[Domain Layer<br/>Aggregates, policies, invariants]
        Repository[Repository Abstraction<br/>Business persistence contracts]
        AIGateway[AI Gateway<br/>Provider abstraction and resilience]
    end

    PostgreSQL[(PostgreSQL<br/>System of Record)]
    ExternalAI[External AI Provider]

    User -->|Requests product capabilities| REST
    REST -->|Invokes business use cases| Application
    Application -->|Executes domain decisions| Domain
    Domain -->|Uses persistence abstractions| Repository
    Repository -->|Reads and writes authoritative data| PostgreSQL

    Application -->|Requests contextual AI assistance| AIGateway
    AIGateway -->|Requests provider assistance| ExternalAI

    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#1a1a1a;
    classDef api fill:#fff2cc,stroke:#d6b656,color:#1a1a1a;
    classDef application fill:#d5e8d4,stroke:#82b366,color:#1a1a1a;
    classDef domain fill:#c6e0b4,stroke:#548235,color:#1a1a1a,stroke-width:3px;
    classDef boundary fill:#e2f0d9,stroke:#70ad47,color:#1a1a1a;
    classDef store fill:#f4cccc,stroke:#cc0000,color:#1a1a1a;
    classDef external fill:#f5f5f5,stroke:#666666,color:#1a1a1a;

    class User actor;
    class REST api;
    class Application application;
    class Domain domain;
    class Repository,AIGateway boundary;
    class PostgreSQL store;
    class ExternalAI external;
