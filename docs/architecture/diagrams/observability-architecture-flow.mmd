    PostgreSQL[(PostgreSQL)]
    Redis[(Redis)]
    Provider[External AI Provider]
    Collector[Telemetry Collection Boundary]
    Metrics[Metrics Backend]
    Logs[Structured Log Backend]
    Traces[Trace Backend]
    Grafana[Grafana Dashboards and Alerts]

    Browser -->|Trace-aware request| API
    API --> Auth
    Auth --> App
    App --> Domain
    App --> Repo
    Repo --> PostgreSQL
    App --> RedisOp
    RedisOp --> Redis
    App --> AI
    AI --> Provider
    Domain -->|Safe business signals| OTel
    API --> OTel
    Auth --> OTel
    App --> OTel
    Repo --> OTel
    RedisOp --> OTel
    AI --> OTel
    OTel -->|Traces, metrics, logs| Collector
    Collector --> Metrics
