flowchart TD
    subgraph Actors[Business Actors]
        User[User<br/>MVP actor]
        Household[Household Member<br/>Future actor]
        Nutrition[Nutrition Professional<br/>Future actor]
        GroceryPartner[Grocery Partner<br/>Future actor]
        Commercial[Commercial Operator<br/>Future actor]
    end

    DapurPintar[DapurPintar AI<br/><br/>AI-first kitchen companion that helps people understand kitchen context, make trustworthy cooking decisions, plan meals, and manage shopping intentions.]

    subgraph External[External Systems and Organizations]
        AIProvider[External AI Provider<br/>MVP external system]
        AuthProvider[Authentication Provider<br/>Future]
        GroceryMarketplace[Grocery Marketplace<br/>Future]
        NotificationProvider[Notification Provider<br/>Future]
        PaymentProvider[Payment Provider<br/>Future]
    end

    User -->|Manages kitchen context and makes cooking decisions| DapurPintar
    Household -.->|Future: collaborates on shared kitchen decisions| DapurPintar
    Nutrition -.->|Future: provides specialized nutrition guidance| DapurPintar
    GroceryPartner -.->|Future: participates in approved grocery integration| DapurPintar
    Commercial -.->|Future: manages commercial participation and partnerships| DapurPintar

    DapurPintar -->|Requests contextual AI assistance| AIProvider
    DapurPintar -.->|Future: exchanges identity or verification information| AuthProvider
    DapurPintar -.->|Future: exchanges approved purchase intent| GroceryMarketplace
    DapurPintar -.->|Future: requests reminder delivery| NotificationProvider
    DapurPintar -.->|Future: requests subscription payment processing| PaymentProvider

    classDef actor fill:#dae8fc,stroke:#6c8ebf,color:#1a1a1a;
    classDef system fill:#d5e8d4,stroke:#82b366,color:#1a1a1a,stroke-width:3px;
    classDef external fill:#fff2cc,stroke:#d6b656,color:#1a1a1a;
    classDef future fill:#f5f5f5,stroke:#666666,color:#1a1a1a,stroke-dasharray: 5 5;

    class User actor;
    class Household,Nutrition,GroceryPartner,Commercial future;
    class DapurPintar system;
    class AIProvider external;
    class AuthProvider,GroceryMarketplace,NotificationProvider,PaymentProvider future;
