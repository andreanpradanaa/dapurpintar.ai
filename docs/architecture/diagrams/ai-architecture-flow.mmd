flowchart LR
    User[User]
    API[REST API<br/>/api/v1]

    subgraph Application[AI Application Boundary]
        UseCase[AI Use Cases<br/>Recommendation and Pantry Analysis]
        Auth[Authorization<br/>Authenticated User scope]
        Context[Context Assembler<br/>Purpose-specific and minimized]
        Policy[Prompt and Safety Policy<br/>Versioned revisions]
        Gateway[AI Gateway<br/>Provider-neutral contract]
        Validate[Output Validation<br/>Schema, source, business, safety]
    end

    subgraph Sources[Authorized Product Context]
        Profile[User Profile and Preferences]
        Pantry[Pantry Management]
        Recipe[Culinary Knowledge and Recipes]
        Meal[Meal Planning]
        Shopping[Shopping Optimization]
    end

    Provider[OpenAI Provider Adapter]
    External[External AI Provider]
    Recommendation[Kitchen Recommendation<br/>Aggregate and Conversation context]
    PostgreSQL[(PostgreSQL<br/>Authoritative business state)]
    Redis[(Redis<br/>Safe cache and bounded coordination)]

    User --> API
    API --> Auth
    Auth --> UseCase
    UseCase --> Context
    Context --> Profile
    Context --> Pantry
    Context --> Recipe
    Context --> Meal
    Context --> Shopping
    Context --> Policy
    Context --> Gateway
    Gateway --> Provider
    Provider --> External
    External --> Provider
    Provider --> Gateway
    Gateway --> Validate
    Policy --> Validate
    Validate -->|Validated proposal| UseCase
    UseCase -->|Create or update recommendation state| Recommendation
    Recommendation --> PostgreSQL
    Gateway -->|Safe scoped cache or coordination only| Redis
    UseCase -->|Accepted option informs explicit command| Meal
    UseCase -->|Accepted option informs explicit command| Shopping

