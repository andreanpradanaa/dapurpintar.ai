flowchart TD
    Start[Landing / public recipe discovery]
    Auth[Register or login]
    Setup[Set minimum cooking context]
    Today[Today: choose the next action]
    Pantry[Add or correct pantry context]
    Request[Request recommendation]
    Context[Review context strip]
    Options[Review recommendation options]
    Conversation[Ask about this recommendation]
    Accept[Accept one option]
    Plan[Explicitly add to Meal Plan]
    Shop[Explicitly generate Shopping List]
    Cook[Open recipe and cook]
    Browse[Browse recipes without AI]
    Failure[AI unavailable: browse or retry]

    Start --> Auth
    Auth --> Setup
    Setup --> Today
    Today --> Pantry
    Today --> Request
    Today --> Browse
    Pantry --> Request
    Request --> Context
    Context --> Options
    Options --> Conversation
    Conversation --> Options
    Options --> Accept
    Request --> Failure
    Failure --> Browse
    Failure --> Request
    Accept --> Plan
    Accept --> Shop
    Accept --> Cook
    Plan --> Shop
    Plan --> Cook
    Shop --> Cook

    classDef entry fill:#F4F1E8,stroke:#8793A5,color:#17243A;
    classDef action fill:#A7D46F,stroke:#5D7D36,color:#17243A;
    classDef ai fill:#F3C969,stroke:#9A7620,color:#17243A;
    classDef commitment fill:#F45B3C,stroke:#A52F1C,color:#FFFFFF;
    classDef fallback fill:#E2E5EA,stroke:#8793A5,color:#17243A;

    class Start,Auth,Setup entry;
    class Today,Pantry,Browse,Cook action;
    class Request,Context,Options,Conversation ai;
    class Accept,Plan,Shop commitment;
    class Failure fallback;
