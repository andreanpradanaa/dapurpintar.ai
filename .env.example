APP_NAME=dapurpintar

APP_ENV=development

APP_PORT=8080

# PostgreSQL is the system of record.
DATABASE_URL=postgres://dapurpintar:dapurpintar@localhost:5432/dapurpintar

# Redis is supporting infrastructure only; never an authorization source of truth.
REDIS_URL=redis://localhost:6379/0

# Required. Short-lived access token signing secret (deployment secret in production).
JWT_SECRET=

# Access and refresh session lifetimes.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

SESSION_COOKIE_NAME=dp_session

# OpenTelemetry OTLP/HTTP trace endpoint. Disabled by default in local development.
OTLP_ENDPOINT=http://localhost:4318
OTLP_DISABLE=true

SHUTDOWN_TIMEOUT=10s

# AI Gateway (M8, ADR-010). AI_PROVIDER empty disables AI; core non-AI
# operations remain fully usable and AI features fail closed.
AI_PROVIDER=
AI_API_KEY=

# Approved model profile (M4-DEC-010). Defaults to the local development model.
AI_MODEL=gpt-4o-mini

# Bounded provider operation deadline and automatic retries for transient
# failures (M4-DEC-016).
AI_TIMEOUT=30s
AI_MAX_RETRIES=1
