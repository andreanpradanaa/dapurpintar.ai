# Example env file. Copy to .env.local and adjust as needed.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave NEXT_PUBLIC_API_URL empty to use the Next.js same-origin proxy.
# Set this only when the browser should call the backend directly.
NEXT_PUBLIC_API_URL=
# Server-side Next.js proxy target. Keep this local for development.
BACKEND_URL=http://localhost:8080
